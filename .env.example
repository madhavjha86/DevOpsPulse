# Application
APP_NAME=DevOpsPulse
VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://devopspulse:devopspulse@db:5432/devopspulse
DATABASE_URL_SYNC=postgresql://devopspulse:devopspulse@db:5432/devopspulse
POSTGRES_USER=devopspulse
POSTGRES_PASSWORD=devopspulse
POSTGRES_DB=devopspulse

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
