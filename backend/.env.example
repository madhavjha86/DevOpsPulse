# Application
APP_NAME=DevOpsPulse
VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# PostgreSQL 18 Database Configuration (Local Windows / Direct execution)
# Note: If your password contains special characters (like '@', '#', '$'),
# ensure it is URL-encoded in DATABASE_URL (e.g. '@' becomes '%40'),
# while POSTGRES_PASSWORD contains the raw unencoded password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_pg_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devopspulse

DATABASE_URL=postgresql+asyncpg://postgres:your_local_pg_password@localhost:5432/devopspulse
DATABASE_URL_SYNC=postgresql://postgres:your_local_pg_password@localhost:5432/devopspulse

# Redis / Caching
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
